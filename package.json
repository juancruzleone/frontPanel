{
  "name": "package",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.startsWith('bun/')) { console.error('Usá bun install para instalar dependencias.'); process.exit(1); }\"",
    "dev": "vite",
    "build": "vite build",
    "build:netlify": "rm -rf dist && bun ci --ignore-scripts && vite build",
    "build:clean": "rm -rf dist node_modules && bun ci --ignore-scripts && vite build",
    "lint": "eslint . --max-warnings 999",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:performance": "lighthouse http://localhost:5173 --output=json --output-path=./reports/lighthouse.json",
    "test:all": "bun run lint && bun run type-check && bun run test:unit && bun run test:integration && bun run test:security && bun run test:e2e",
    "install:safe": "bun install --ignore-scripts",
    "install:ci": "bun ci --ignore-scripts",
    "pm:clean": "rm -rf node_modules && bun pm cache rm",
    "security:audit": "bun audit --audit-level=moderate",
    "security:audit:fix": "bun update",
    "security:check": "bun run security:audit && bun outdated",
    "ci": "bun run lint && bun run type-check && bun run test:all && bun run build",
    "ci:test": "bun run test:unit && bun run test:integration && bun run test:security",
    "ci:e2e": "bun run test:e2e"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react-modal": "^3.16.3",
    "driver.js": "^1.4.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.511.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^15.7.4",
    "react-icons": "^5.6.0",
    "react-is": "^18.3.1",
    "react-modal": "^3.16.3",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "yup": "^1.7.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.3.0",
    "msw": "^2.14.6",
    "rollup": "^4.60.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "basic-ftp": "^6.0.1",
    "brace-expansion": "^2.0.3",
    "flatted": "^3.4.2",
    "ip-address": "^10.2.0",
    "minimatch": "^9.0.7",
    "ws": "^8.20.1"
  }
}
