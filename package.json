{
  "name": "package",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.startsWith('bun/')) { console.error('Usá bun install para instalar dependencias.'); process.exit(1); }\"",
    "dev": "vite",
    "build": "vite build",
    "build:netlify": "rm -rf dist && bun install --frozen-lockfile && vite build",
    "build:clean": "rm -rf dist node_modules && bun install --frozen-lockfile && vite build",
    "lint": "eslint . --max-warnings 999",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:performance": "lighthouse http://localhost:5173 --output=json --output-path=./reports/lighthouse.json",
    "test:all": "bun run lint && bun run type-check && bun run test:unit && bun run test:integration && bun run test:security && bun run test:e2e",
    "security:audit": "bun audit --audit-level=moderate",
    "security:audit:fix": "bun update",
    "security:check": "bun run security:audit && bun outdated",
    "ci": "bun run lint && bun run type-check && bun run test:all && bun run build",
    "ci:test": "bun run test:unit && bun run test:integration && bun run test:security",
    "ci:e2e": "bun run test:e2e"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react-modal": "^3.16.3",
    "driver.js": "^1.3.6",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.511.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.0",
    "react-icons": "^5.5.0",
    "react-is": "^18.3.1",
    "react-modal": "^3.16.3",
    "react-router-dom": "^7.6.0",
    "recharts": "^3.0.2",
    "socket.io-client": "^4.7.2",
    "sonner": "^2.0.1",
    "yup": "^1.6.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^25.0.1",
    "lighthouse": "^12.2.1",
    "msw": "^2.7.0",
    "rollup": "^4.24.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^2.1.8"
  }
}
