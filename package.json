{
  "name": "package",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.5"
  },
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.startsWith('bun/')) { console.error('Usá bun install para instalar dependencias.'); process.exit(1); }\"",
    "dev": "vite",
    "build": "vite build",
    "build:netlify": "rm -rf dist && bun ci --ignore-scripts && vite build",
    "build:clean": "rm -rf dist node_modules && bun ci --ignore-scripts && vite build",
    "lint": "eslint . --max-warnings 999",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "bun run build && playwright test --config=playwright.pwa.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:performance": "lighthouse http://localhost:5173 --output=json --output-path=./reports/lighthouse.json",
    "test:all": "bun run lint && bun run type-check && bun run test:unit && bun run test:integration && bun run test:security && bun run test:e2e",
    "install:safe": "bun install --ignore-scripts",
    "install:ci": "bun ci --ignore-scripts",
    "pm:clean": "rm -rf node_modules && bun pm cache rm",
    "security:audit": "bun audit --audit-level=moderate",
    "security:audit:fix": "bun update",
    "security:check": "bun run security:audit && bun outdated",
    "ci": "bun run lint && bun run type-check && bun run test:all && bun run build",
    "ci:test": "bun run test:unit && bun run test:integration && bun run test:security",
    "ci:e2e": "bun run test:e2e && bun run test:e2e:pwa"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react-modal": "^3.16.3",
    "driver.js": "^1.8.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.27.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-icons": "^5.7.0",
    "react-is": "^19.2.8",
    "react-modal": "^3.16.3",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "yup": "^1.7.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "lighthouse": "^13.4.1",
    "msw": "^2.15.0",
    "rollup": "^4.62.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "basic-ftp": "^6.0.1",
    "brace-expansion": "^5.0.9",
    "flatted": "^3.4.2",
    "ip-address": "^10.2.0",
    "js-yaml": "^4.3.1",
    "minimatch": "^10.2.6",
    "nanoid": "^3.3.18",
    "socket.io-parser": "^4.2.7",
    "ws": "^8.21.0"
  }
}
