# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================
# 
# IMPORTANTE: Este archivo es un template
# Copiar a .env y configurar valores reales
# 
# ⚠️  NUNCA commitear el archivo .env
# ⚠️  Solo variables VITE_* son seguras en frontend
# ============================================

# ============================================
# API CONFIGURATION
# ============================================

# URL del backend API
# Development (REQUIRED for HttpOnly cookies from localhost): /api/
# Alternative direct backend URL ONLY if backend cookies are configured for cross-site dev: http://localhost:3000/api/
# Staging: https://api-staging.leonix.net.ar
# Production: https://api.leonix.net.ar/api/
VITE_API_URL=/api/

# Timeout para requests (ms)
VITE_API_TIMEOUT=30000

# ============================================
# ENVIRONMENT
# ============================================

# Entorno actual: development | staging | production
VITE_ENVIRONMENT=development

# ============================================
# FEATURE FLAGS
# ============================================

# Habilitar analytics (Google Analytics, etc)
VITE_ENABLE_ANALYTICS=false

# Habilitar error tracking (Sentry, etc)
VITE_ENABLE_ERROR_TRACKING=false

# Habilitar modo debug
VITE_DEBUG_MODE=true

# ============================================
# THIRD PARTY SERVICES (Public Keys Only)
# ============================================

# Google Analytics (solo en producción)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry DSN (solo clave pública)
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Google Maps API Key (solo clave pública)
# VITE_GOOGLE_MAPS_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Stripe Public Key (solo clave pública)
# VITE_STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# ============================================
# SECURITY
# ============================================

# Tiempo de expiración de sesión (ms)
# 30 minutos = 1800000
VITE_SESSION_TIMEOUT=1800000

# Habilitar modo estricto de seguridad
VITE_STRICT_MODE=true

# ============================================
# PERFORMANCE
# ============================================

# Habilitar lazy loading de componentes
VITE_ENABLE_LAZY_LOADING=true

# Tamaño máximo de cache (MB)
VITE_MAX_CACHE_SIZE=50

# ============================================
# NOTAS IMPORTANTES
# ============================================
#
# 1. NUNCA incluir secretos o API keys privadas
# 2. Solo variables con prefijo VITE_* son accesibles
# 3. Todas las variables son públicas en el bundle
# 4. Secretos deben estar en el backend
# 5. Este archivo debe estar en .gitignore
#
# ============================================
