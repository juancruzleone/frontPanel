# Configuración de seguridad para npm

# Auditoría automática en cada instalación (deshabilitada para evitar fallos en CI)
# La auditoría se ejecuta en un job separado de CI
audit=false

# Nivel de auditoría (low, moderate, high, critical)
# audit-level=moderate

# Verificar integridad de paquetes
package-lock=true

# No ejecutar scripts de instalación automáticamente (seguridad)
ignore-scripts=false

# Usar solo registry oficial de npm
registry=https://registry.npmjs.org/

# Timeout para requests
fetch-timeout=60000

# Reintentos en caso de fallo
fetch-retries=2
