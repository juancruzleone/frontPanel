# Configuración compartida de registry/seguridad.
# Las dependencias de este proyecto se instalan únicamente con Bun.

# Auditoría automática en cada instalación (deshabilitada para evitar fallos en CI)
# La auditoría se ejecuta en un job separado de CI
audit=false

# Nivel de auditoría (low, moderate, high, critical)
# audit-level=moderate

# No generar package-lock: el lockfile canónico es bun.lock
package-lock=false

# No ejecutar scripts de instalación automáticamente si alguien usa npm por error.
# Bun ya no ejecuta lifecycle scripts de dependencias arbitrarias por defecto.
ignore-scripts=true

# Usar solo registry oficial de npm
registry=https://registry.npmjs.org/

# Timeout para requests
fetch-timeout=60000

# Reintentos en caso de fallo
fetch-retries=2
